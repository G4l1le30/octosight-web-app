# ── Gemini AI Configuration ──────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
# Multiple keys separated by comma — rotated automatically when one hits quota limit
GEMINI_API_KEY=your-gemini-api-key-here

# ── App Environment ──────────────────────────────────────────────────────────
# Set to 'production' to enable secure cookies and strict security policies
ENVIRONMENT=development

# ── Database Configuration ──────────────────────────────────────────────────
MYSQL_USER=octouser
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=octosight_db
MYSQL_HOST=db
MYSQL_ROOT_PASSWORD=change-me-root

# ── Authentication & Security ───────────────────────────────────────────────
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=your-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost

# ── Default Admin Account ───────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_USER_EMAIL=user@example.com
DEFAULT_USER_PASSWORD=User1234

# ── Paths & Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
WHITELIST_PATH=/app/data/whitelist.txt

# ── Email Notification ──────────────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME="OctoSight Admin"

# ── Frontend Configuration ──────────────────────────────────────────────────
# Used by Next.js to proxy requests to the backend container
NEXT_PUBLIC_API_URL=http://backend:8000

# ── Google OAuth Configuration ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id

# ── Supabase Storage Configuration ──────────────────────────────────────────
# Supabase project for secure file storage (evidence uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── API URLs ────────────────────────────────────────────────────────────────
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
